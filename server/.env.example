# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored — never commit real credentials.

# MySQL connection string for your Hostinger database. Format:
#   mysql://<user>:<password>@<host>:<port>/<database>
# Hostinger's remote MySQL must be enabled and this server's outbound IP
# allow-listed — see README.md.
DATABASE_URL=mysql://user:password@host:3306/database

# Shared secret the app sends as the X-API-Key header on every /sync/*
# request. Generate a long random value, e.g.: openssl rand -hex 32
API_KEY=

# Port the server listens on. Managed hosts (Railway/Render) usually set
# this for you automatically — only needed for local dev.
PORT=3000

# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored — never commit real credentials.

# Recommended: the discrete host/database/user/password Hostinger's hPanel
# shows you directly (Databases > MySQL Databases). Building a single
# mysql://user:password@host/db URL by hand risks mangling a password with
# special characters, so these four are read as-is, no URL-encoding needed.
# Hostinger's remote MySQL must be enabled and this server's outbound IP
# allow-listed — see README.md.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Alternative to the DB_* vars above: a single connection string, for hosts
# that hand you one directly (e.g. a managed MySQL add-on). Only used if one
# of the DB_* vars above is unset.
# DATABASE_URL=mysql://user:password@host:3306/database

# Shared secret the app sends as the X-API-Key header on every /sync/*
# request. Generate a long random value, e.g.: openssl rand -hex 32
API_KEY=

# Port the server listens on. Managed hosts (Railway/Render) usually set
# this for you automatically — only needed for local dev.
PORT=3000

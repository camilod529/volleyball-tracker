# -----------------------------------------------------------------------------
# Volleyball Tracker — environment variables
# -----------------------------------------------------------------------------
# The app is fully local today (see docs/SYNC.md) — nothing here is read by
# the app yet. This file exists so the shape of the config is settled before
# that work starts, not because it's wired up now.
#
# To use it once a cloud backend exists:
#   cp .env.example .env
# `.env` is already covered by .gitignore's local-env-file pattern — never
# commit real credentials.
# -----------------------------------------------------------------------------

# --- Security note -----------------------------------------------------------
# A mobile app bundle can be decompiled, so raw database credentials should
# never ship inside the client. The intended shape is: the app talks to a
# small backend API over HTTPS, and that API (not the phone) holds the
# database credentials. The variables below are split along that line —
# DATABASE_* are server-side only and must never be prefixed EXPO_PUBLIC_.
# -------------------------------------------------------------------------

# Connection string for the cloud database, used by the backend API server
# only (Postgres/MySQL/libSQL/etc., depending on what gets chosen later).
DATABASE_URL=postgres://user:password@host:5432/database

# Separate auth token, if the provider uses one instead of (or in addition
# to) embedding credentials in the URL (e.g. Turso, Neon).
DATABASE_AUTH_TOKEN=

# --- Client-side (the app itself) --------------------------------------
# Anything prefixed EXPO_PUBLIC_ is compiled into the client JS bundle and
# is NOT secret — never put a real database credential behind this prefix.

# Base URL of the backend API the app calls (not the database directly).
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# API key/token the app sends with requests, if the backend requires one.
EXPO_PUBLIC_API_KEY=
